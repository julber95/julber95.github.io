---
import { site } from '../data/site';
import { getNotes } from '../lib/notes';
const hasNotes = (await getNotes()).some((n) => !n.data.draft);
const year = new Date().getFullYear();
---
<footer class="colophon page" aria-labelledby="colophon-title">
  <div class="colophon__rule rule" data-draw></div>
  <div class="colophon__grid">
    <div class="colophon__col colophon__col--title">
      <p class="label" id="colophon-title">Colophon</p>
      <p class="colophon__lead">
        Set in <em>Fraunces</em>, Hanken Grotesk and IBM Plex Mono. Engravings drawn in code,
        one per plate. Built with Astro, with no client-side framework and not a single stock image.
      </p>
    </div>
    <div class="colophon__col">
      <p class="label">Correspondence</p>
      <ul role="list" class="colophon__links">
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={site.github} rel="me">GitHub <span class="mono soft">/julber95</span></a></li>
        <li><a href={site.linkedin} rel="me">LinkedIn</a></li>
        {hasNotes && <li><a href="/rss.xml">Notes via RSS</a></li>}
        <li><a href="/cv.pdf">Curriculum vitae <span class="mono soft">(PDF)</span></a></li>
      </ul>
    </div>
    <div class="colophon__col">
      <p class="label">Imprint</p>
      <p class="mono colophon__imprint">
        {site.place}<br />
        {site.coords}<br />
        First edition, {site.established}{year > site.established ? `; revised ${year}` : ''}.<br />
        Plates I–VII<a class="colophon__zero" href="/plate-0/">,&nbsp;0<span class="sr-only">: the missing plate</span></a>.
      </p>
      <button class="colophon__errata label" type="button" data-errata-open>Errata <kbd>?</kbd></button>
    </div>
  </div>
</footer>
