---
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="colophon page" aria-label="Footer">
  <div class="colophon__rule rule" data-draw></div>
  <div class="colophon__grid">
    <div class="colophon__col colophon__col--me">
      <p class="colophon__name">{site.name}</p>
      <p class="label">AI / ML student · Paris</p>
    </div>
    <div class="colophon__col colophon__col--contact">
      <p class="label">Contact</p>
      <ul role="list" class="colophon__links">
        <li><a href={`mailto:${site.email}`}>Email</a></li>
        <li><a href={site.github} rel="me">GitHub</a></li>
        <li><a href={site.linkedin} rel="me">LinkedIn</a></li>
        <li><a href="/cv-en.pdf">CV <span class="mono soft">(EN)</span></a></li>
        <li><a href="/cv-fr.pdf" hreflang="fr">CV <span class="mono soft">(FR)</span></a></li>
      </ul>
    </div>
    <p class="colophon__copy mono">© {year} {site.name}</p>
  </div>
</footer>
