---
import Engraving from './Engraving.astro';
import Taxonomy from './Taxonomy.astro';
import { hrefOf, slugOf, type Plate } from '../lib/plates';
interface Props { plate: Plate; index: number }
const { plate, index } = Astro.props;
const d = plate.data;
const flip = index % 2 === 1;
const slug = slugOf(plate);
---
<article class:list={['fp', { 'fp--flip': flip }]} aria-labelledby={`fp-${slug}`}>
  <a class="fp__figure crop" href={hrefOf(plate)} tabindex="-1" aria-hidden="true" data-reveal style={`view-transition-name: plate-${slug}`}>
    <Engraving name={d.engraving} title={d.figAlt} desc={d.figCaption} decorative />
  </a>
  <div class="fp__text">
    <p class="fp__num" data-reveal><span class="label">Plate</span> <span class="fp__numeral">{d.numeral}</span></p>
    <h3 id={`fp-${slug}`} class="fp__title" data-reveal style="--i:1"><a href={hrefOf(plate)}>{d.title}</a></h3>
    <div data-reveal style="--i:2"><Taxonomy plate={plate} /></div>
    <p class="fp__abstract" data-reveal style="--i:3">{d.abstract}</p>
    <p class="fp__cap mono soft" data-reveal style="--i:4"><span class="ink">Fig. {d.numeral}.</span> {d.figCaption}</p>
    <a class="arrow-link" href={hrefOf(plate)} data-reveal style="--i:5"><span>Open plate {d.numeral}</span><span>→</span></a>
  </div>
</article>

<style>
  .fp { grid-column: 1 / -1; display: grid; grid-template-columns: subgrid; align-items: start; padding-block: var(--s-8); }
  .fp + .fp { border-top: var(--hair) solid var(--rule); }
  .fp__figure { grid-column: 1 / span 6; display: block; color: var(--ink); }
  .fp__text { grid-column: 8 / span 5; display: grid; gap: var(--s-4); align-content: start; padding-top: var(--s-4); }
  .fp--flip .fp__figure { grid-column: 7 / span 6; grid-row: 1; }
  .fp--flip .fp__text { grid-column: 2 / span 4; grid-row: 1; }
  .fp__num { display: flex; align-items: baseline; gap: .8rem; }
  .fp__numeral { font-family: var(--f-display); font-size: clamp(3rem, 2rem + 3vw, 5.5rem); font-weight: 300; line-height: .8; letter-spacing: -.02em; color: var(--accent); font-variation-settings: 'opsz' 144; }
  .fp__title { font-size: var(--t-h2); line-height: 1.02; }
  .fp__title a { text-decoration: none; background: linear-gradient(var(--accent), var(--accent)) 0 100% / 0 var(--hair) no-repeat; transition: background-size var(--dur-3) var(--ease); }
  .fp__title a:hover { background-size: 100% var(--hair); }
  .fp__abstract { max-width: 52ch; }
  .fp__cap { font-size: .72rem; line-height: 1.55; max-width: 52ch; padding-top: var(--s-3); border-top: var(--hair) solid var(--rule); }
  .fp__cap .ink { color: var(--ink); }
  .fp :global(.engraving svg) { width: 100%; height: auto; }
  @media (max-width: 860px) {
    .fp, .fp--flip { display: flex; flex-direction: column; gap: var(--s-6); padding-block: var(--s-7); }
    .fp__figure, .fp--flip .fp__figure { width: 100%; }
  }
</style>
