---
import { nav as allNav } from '../data/site';
import { hasPublishedNotes } from '../lib/notes';
import { langOf, localize, otherLang, t, type Key } from '../i18n/ui';
const lang = langOf(Astro.url);
const alt = otherLang(Astro.url.pathname);
const label = (l: string) => t(lang, `nav.${l}` as Key);
// Notes stays out of the menu until a note is published
const nav = ((await hasPublishedNotes()) ? allNav : allNav.filter((n) => n.href !== '/notes/')).map((n) => ({ ...n, href: localize(n.href, lang), label: label(n.label) }));
const norm = (h: string) => h.replace(/\/$/, '') || '/';
const path = norm(Astro.url.pathname);
const home = localize('/', lang);
const isCurrent = (href: string) => { const h = norm(href); return h === norm(home) ? path === h : path === h || path.startsWith(h + '/'); };
---
<header class="masthead" data-masthead>
  <a class="masthead__mark" href={home} aria-label={t(lang, 'home')}>
    <svg class="masthead__logo" viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 10.5 12 3.5l8.5 7" /><path d="M5.5 9v11h13V9" /><path d="M10 20v-5.5h4V20" /></svg>
    <span class="masthead__home label">{t(lang, 'home')}</span>
  </a>

  <nav class="toc" aria-label={t(lang, 'contents')}>
    <ol role="list" class="toc__list">
      {nav.slice(1).map((item) => (
        <li>
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            <span class="toc__t">{item.label}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>

  <div class="masthead__tools">
    <a class="lang-switch label" href={alt.href} hreflang={alt.lang} lang={alt.lang} aria-label={t(lang, 'lang.switch')} title={t(lang, 'lang.switch')} data-lang-switch>
      <span class:list={{ on: lang === 'fr' }}>FR</span><span aria-hidden="true" class="lang-switch__sep"></span><span class:list={{ on: lang === 'en' }}>EN</span>
    </a>
    <button class="theme-toggle label" type="button" data-theme-toggle aria-pressed="false" aria-label={t(lang, 'dark')}>
      <span class="theme-toggle__dot" aria-hidden="true"></span>
      <span>{t(lang, 'dark')}</span>
    </button>
    <button class="toc-open label" type="button" aria-expanded="false" aria-controls="toc-overlay" data-toc-open>{t(lang, 'contents')}</button>
  </div>
</header>

<div class="toc-overlay" id="toc-overlay" data-toc-overlay role="dialog" aria-modal="true" aria-label={t(lang, 'contents')} hidden>
  <div class="toc-overlay__head">
    <span class="label">{t(lang, 'contents')}</span>
    <button class="label" type="button" data-toc-close>{t(lang, 'close')}</button>
  </div>
  <nav aria-label={t(lang, 'contents')}>
    <ol role="list" class="toc-overlay__list">
      {nav.map((item, i) => (
        <li style={`--i:${i}`}>
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            <span class="toc-overlay__t">{item.label}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
  <p class="toc-overlay__foot"><button class="label" type="button" data-errata-open data-toc-errata>{t(lang, 'errata.open')}</button></p>
</div>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const current = () =>
    (root.dataset.theme as 'light' | 'dark' | undefined) ??
    (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  const paint = () => {
    const t = current();
    toggle?.setAttribute('aria-pressed', String(t === 'dark'));
    document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]').forEach((m) => (m.content = t === 'dark' ? '#141413' : '#F4F7FB'));
  };
  const flip = () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('atlas-theme', next); } catch {}
    paint();
    window.dispatchEvent(new CustomEvent('atlas:theme'));
  };
  toggle?.addEventListener('click', flip);
  window.addEventListener('atlas:toggle-theme', flip);
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', paint);
  paint();

  // switching language keeps the query string (project filters)
  const ls = document.querySelector<HTMLAnchorElement>('[data-lang-switch]');
  if (ls && location.search) ls.href = ls.pathname + location.search;

  // masthead hairline once scrolled
  const mh = document.querySelector<HTMLElement>('[data-masthead]');
  const onScroll = () => mh?.classList.toggle('is-scrolled', scrollY > 8);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // mobile overlay
  const overlay = document.querySelector<HTMLElement>('[data-toc-overlay]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-toc-open]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-toc-close]');
  const open = () => {
    if (!overlay) return;
    overlay.hidden = false;
    document.querySelectorAll<HTMLElement>('main, footer, .masthead').forEach((el) => (el.inert = true));
    requestAnimationFrame(() => overlay.classList.add('is-open'));
    openBtn?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    overlay.querySelector<HTMLElement>('a')?.focus();
  };
  const close = () => {
    if (!overlay || overlay.hidden) return;
    overlay.classList.remove('is-open');
    openBtn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    document.querySelectorAll<HTMLElement>('main, footer, .masthead').forEach((el) => (el.inert = false));
    setTimeout(() => (overlay.hidden = true), 300);
    openBtn?.focus();
  };
  openBtn?.addEventListener('click', open);
  closeBtn?.addEventListener('click', close);
  document.querySelector('[data-toc-errata]')?.addEventListener('click', close);
  addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
  overlay?.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return;
    const f = [...overlay.querySelectorAll<HTMLElement>('a, button')];
    const first = f[0], last = f[f.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last?.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first?.focus(); }
  });
</script>
