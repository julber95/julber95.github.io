---
/* Plate V — a lymph node in section, as in an old histology atlas.
   Capsule, cortex with follicles, medulla with cords, hilum with vessels; one metastatic focus. */
import Frame from './Frame.astro';
import { rng, line, smooth, wobble, hatch, dots, closed, inPoly, sampleCurve, int, type P } from '../../lib/engrave';

interface Props { uid: string; title: string; desc: string }
const { uid, title, desc } = Astro.props;
const R = rng(5005);

// ── local helpers ────────────────────────────────
const TAU = Math.PI * 2;
const angDiff = (a: number, b: number) => { let d = (a - b) % TAU; if (d > Math.PI) d -= TAU; if (d < -Math.PI) d += TAU; return d; };
function segDist(p: P, a: P, b: P) {
  const dx = b[0] - a[0], dy = b[1] - a[1];
  const t = Math.max(0, Math.min(1, ((p[0] - a[0]) * dx + (p[1] - a[1]) * dy) / (dx * dx + dy * dy || 1)));
  return Math.hypot(p[0] - a[0] - dx * t, p[1] - a[1] - dy * t);
}
function polyDist(poly: P[], p: P, closedPoly = true) {
  let m = Infinity;
  const n = closedPoly ? poly.length : poly.length - 1;
  for (let i = 0; i < n; i++) m = Math.min(m, segDist(p, poly[i]!, poly[(i + 1) % poly.length]!));
  return m;
}
/** offset a closed polygon along its normals (negative = inward for a CCW-in-screen outline) */
function offset(poly: P[], d: number): P[] {
  const n = poly.length;
  return poly.map((p, i) => {
    const a = poly[(i - 1 + n) % n]!, b = poly[(i + 1) % n]!;
    const dx = b[0] - a[0], dy = b[1] - a[1], l = Math.hypot(dx, dy) || 1;
    return [p[0] + (dy / l) * d, p[1] - (dx / l) * d];
  });
}

/** Compact stipple: round to whole px, drop near-duplicates, then encode as relative moves in a serpentine scan. */
function rdots(pts: P[], minGap = 1.6, band = 6): string {
  const seen = new Map<string, P[]>();
  const kept: P[] = [];
  for (const q of pts) {
    const p: P = [Math.round(q[0]), Math.round(q[1])];
    const kx = Math.floor(p[0] / 4), ky = Math.floor(p[1] / 4);
    let ok = true;
    for (let i = -1; i <= 1 && ok; i++) for (let j = -1; j <= 1 && ok; j++)
      for (const o of seen.get(`${kx + i},${ky + j}`) ?? []) if (Math.hypot(o[0] - p[0], o[1] - p[1]) < minGap) { ok = false; break; }
    if (!ok) continue;
    const key = `${kx},${ky}`; (seen.get(key) ?? seen.set(key, []).get(key)!).push(p); kept.push(p);
  }
  kept.sort((a, b) => { const ba = Math.floor(a[1] / band), bb = Math.floor(b[1] / band); return ba - bb || (ba % 2 ? b[0] - a[0] : a[0] - b[0]); });
  let d = '', c: P | null = null;
  for (const p of kept) { d += c ? `m${p[0] - c[0]} ${p[1] - c[1]}h0` : `M${p[0]} ${p[1]}h0`; c = p; }
  return d;
}

// ── the node outline: a bean, notched at the hilum (right) ──
const C: P = [272, 206];
const RX = 192, RY = 128, TH = 0.12;          // hilum angle
const ph1 = R.next() * TAU, ph2 = R.next() * TAU;
const radial = (t: number) => 1 - 0.25 * Math.exp(-((angDiff(t, TH) / 0.27) ** 2)) + 0.018 * Math.sin(3 * t + ph1) + 0.012 * Math.sin(5 * t + ph2);
const N = 84;
const outline: P[] = Array.from({ length: N }, (_, i) => {
  const t = (i / N) * TAU, k = radial(t);
  return [C[0] + Math.cos(t) * RX * k, C[1] + Math.sin(t) * RY * k];
});
const at = (t: number, inset = 0): P => {
  const k = radial(t);
  const p: P = [C[0] + Math.cos(t) * RX * k, C[1] + Math.sin(t) * RY * k];
  const v = [C[0] - p[0], C[1] - p[1]], l = Math.hypot(v[0]!, v[1]!);
  return [p[0] + (v[0]! / l) * inset, p[1] + (v[1]! / l) * inset];
};
// screen y is down, so this sampling runs clockwise on screen: the left-hand normal points outward
const inner = offset(outline, -3.6);
const capsuleOut = closed(outline, 0.5), capsuleIn = closed(inner, 0.5);
const H = at(TH);                        // hilum mouth
const Hin = at(TH, 34);                  // where medullary cords converge

// ── follicles in the cortex ──
const folT = [-2.45, -1.75, 1.05, 1.8, 2.55, 3.3, 3.95].map((t) => t + R.gauss() * 0.05);
const fol = folT.map((t, i) => ({ c: at(t, 27 + R.gauss() * 1.5), r: (i === 6 ? 17 : 20) + R.next() * 4 }));

// ── the metastatic focus: subcapsular, between follicles, upper right ──
const MT = -0.95;
const M = at(MT, 21);
const metCells: P[] = [];
for (let i = 0; i < 46; i++) {
  const a = R.next() * TAU, rr = Math.sqrt(R.next()) * 11;
  const lobe = 1 + 0.35 * Math.sin(a * 2 + 1) + 0.2 * Math.sin(a * 3);
  metCells.push([M[0] + Math.cos(a) * rr * lobe * 1.15, M[1] + Math.sin(a) * rr * lobe * 0.8]);
}
const nearMet = (x: number, y: number) => Math.hypot((x - M[0]) / 1.3, y - M[1]) < 15;

// ── medullary cords: meandering strands converging on the hilum ──
const cordT = [-2.5, -2.05, -1.6, -1.15, -0.7, -0.3, 0.55, 0.95, 1.4, 1.85, 2.3, 2.75, 3.2, 3.7];
const cords: P[][] = cordT.map((t) => {
  const s = at(t, 70 + R.gauss() * 3);
  const end: P = [Hin[0] + R.gauss() * 4, Hin[1] + R.gauss() * 8];
  const pts: P[] = [s];
  const steps = 6;
  for (let k = 1; k < steps; k++) {
    const f = k / steps;
    const x = s[0] + (end[0] - s[0]) * f, y = s[1] + (end[1] - s[1]) * f;
    const nx = -(end[1] - s[1]), ny = end[0] - s[0], l = Math.hypot(nx, ny);
    const w = Math.sin(f * Math.PI) * R.gauss() * 7;
    pts.push([x + (nx / l) * w, y + (ny / l) * w]);
  }
  pts.push(end);
  return sampleCurve(pts, 4);
});
// short side-branches, so the cords anastomose
for (let i = 0; i < 12; i++) {
  const c = cords[Math.floor(R.next() * cordT.length)]!;
  const p = c[2 + Math.floor(R.next() * 12)]!;
  const a = R.next() * TAU;
  cords.push(sampleCurve([p, [p[0] + Math.cos(a) * 9, p[1] + Math.sin(a) * 9], [p[0] + Math.cos(a + 0.5) * 17, p[1] + Math.sin(a + 0.5) * 17]], 3));
}
const cordDist = (p: P) => { let m = Infinity; for (const c of cords) m = Math.min(m, polyDist(c, p, false)); return m; };

// ── stipple: jittered grid, density by tissue zone ──
const fine: P[] = [], mid: P[] = [], dense: P[] = [];
const S = 2.7;
for (let gy = C[1] - RY - 4; gy < C[1] + RY + 4; gy += S) {
  for (let gx = C[0] - RX - 4; gx < C[0] + RX + 4; gx += S) {
    const p: P = [gx + R.next() * S, gy + R.next() * S];
    if (!inPoly(outline, p[0], p[1])) continue;
    const d = polyDist(outline, p);
    if (d < 4.6 || nearMet(p[0], p[1])) continue;
    const dh = Math.hypot(p[0] - H[0], p[1] - H[1]);
    // follicles: a dense mantle ring around a paler germinal centre
    let inF = false;
    for (const f of fol) {
      const u = Math.hypot(p[0] - f.c[0], p[1] - f.c[1]) / f.r;
      if (u < 1.1) {
        inF = true;
        const dn = u < 0.6 ? 0.16 + u * 0.3 : u < 1 ? 1 : 0.55;
        if (R.next() < dn) (u > 0.6 && u < 1 ? dense : u < 0.6 ? fine : mid).push(p);
        break;
      }
    }
    if (inF) continue;
    if (dh < 24) { if (R.next() < 0.04) fine.push(p); continue; }          // hilum: loose, almost empty
    const cx = dh < 80 ? 0 : 42;                                         // no cortex at the hilum
    let dn: number, bucket = fine;
    if (d < 8) dn = 0.12;                                                // subcapsular sinus
    else if (d < cx) { dn = 0.47; bucket = mid; }                        // outer cortex
    else if (d < cx + 28) dn = 0.42 - ((d - cx) / 28) * 0.28;             // paracortex, fading inward
    else { const cd = cordDist(p); dn = cd < 2.8 ? 0.85 : cd < 4.4 ? 0.3 : 0.02; if (cd < 2.8) bucket = mid; }  // medulla
    if (R.next() < dn) bucket.push(p);
  }
}

// trabeculae: fine fibrous strands from the capsule into the cortex, between follicles
let trab = '';
for (const t of [-2.1, -1.35, -0.55, 0.6, 1.42, 2.18, 2.92, 3.62, 4.3]) {
  const a = at(t + R.gauss() * 0.03, 4), b = at(t + R.gauss() * 0.05, 22 + R.next() * 12);
  trab += smooth([a, [(a[0] + b[0]) / 2 + R.gauss() * 1.5, (a[1] + b[1]) / 2 + R.gauss() * 1.5], b], 0.5);
}

// ── hilum vessels: hatched tubes leaving to the right ──
function tube(c: P[], w: number) {
  const pts = sampleCurve(c, 6);
  const L: P[] = [], Rt: P[] = [], Mid: P[] = [];
  for (let i = 0; i < pts.length; i++) {
    const a = pts[Math.max(0, i - 1)]!, b = pts[Math.min(pts.length - 1, i + 1)]!;
    const dx = b[0] - a[0], dy = b[1] - a[1], l = Math.hypot(dx, dy) || 1;
    const tt = i / (pts.length - 1), ww = w * Math.min(1, 0.3 + tt * 3) * (1 + 0.04 * Math.sin(i * 0.7));
    L.push([pts[i]![0] - (dy / l) * ww, pts[i]![1] + (dx / l) * ww]);
    Rt.push([pts[i]![0] + (dy / l) * ww, pts[i]![1] - (dx / l) * ww]);
    Mid.push([pts[i]![0] + (dy / l) * ww * 0.25, pts[i]![1] - (dx / l) * ww * 0.25]);
  }
  return { body: line([...L, ...[...Rt].reverse()]) + 'Z', shade: line([...L, ...[...Mid].reverse()]) + 'Z', sheen: smooth(Rt.map((q, i) => [q[0] * 0.62 + Mid[i]![0] * 0.38, q[1] * 0.62 + Mid[i]![1] * 0.38] as P).slice(4), 0.4), top: smooth(Rt, 0.4), bot: smooth(L, 0.4), end: L[L.length - 1]!, endT: Rt[Rt.length - 1]! };
}
const vein = tube([[H[0] - 34, H[1] - 1], [H[0] + 8, H[1] - 9], [H[0] + 50, H[1] - 20], [H[0] + 92, H[1] - 30], [H[0] + 122, H[1] - 44]], 6.4);
const art = tube([[H[0] - 32, H[1] + 5], [H[0] + 10, H[1] + 9], [H[0] + 52, H[1] + 16], [H[0] + 94, H[1] + 30], [H[0] + 124, H[1] + 34]], 3.6);
const vesBox = { x: H[0] - 30, y: H[1] - 60, w: 170, h: 110 };
const veinH = hatch(vesBox, -40, 2.2, R);
const artH = hatch(vesBox, -40, 1.9, R);
// lumen ellipses at the cut ends
const lumen = (a: P, b: P, k: number) => {
  const cx = (a[0] + b[0]) / 2, cy = (a[1] + b[1]) / 2, rr = Math.hypot(b[0] - a[0], b[1] - a[1]) / 2;
  const ang = Math.atan2(b[1] - a[1], b[0] - a[0]) * 180 / Math.PI;
  return { cx, cy, rx: rr * k, ry: rr, ang };
};
const vL = lumen(vein.end, vein.endT, 0.45), aL = lumen(art.end, art.endT, 0.5);

// ── callouts ──
const capP = at(-2.6, 0), folB = fol[3]!, medP: P = [Hin[0] - 62, Hin[1] + 30];
const scaleY = 398, scaleX = 470, scaleW = 70;
---
<Frame uid={uid} title={title} desc={desc} numeral="V" taxon="Nodus lymphaticus" keyText="red · metastatic focus">
  <defs>
    <clipPath id={`${uid}-vn`}><path d={vein.shade} /></clipPath>
    <clipPath id={`${uid}-ar`}><path d={art.shade} /></clipPath>
  </defs>

  <!-- tissue in stipple -->
  <path class="k mid" style="stroke-width:0.85" d={rdots(fine)} />
  <path class="k" style="stroke-width:0.95" d={rdots(mid)} />
  <path class="k" style="stroke-width:1.2" d={rdots(dense)} />
  <path class="k w04 faint" d={int(trab)} />

  <!-- capsule: double contour, heavier on the shadow side -->
  <path class="k w13" d={capsuleOut} />
  <path class="k w05" d={capsuleIn} />

  <!-- hilum vessels -->
  <path class="bg" d={vein.body} />
  <path class="k w04" d={int(veinH)} clip-path={`url(#${uid}-vn)`} />
  <path class="k w08" d={vein.top + vein.bot} /><path class="k w04 mid" d={vein.sheen} />
  <ellipse class="bg" cx={vL.cx} cy={vL.cy} rx={vL.rx} ry={vL.ry} transform={`rotate(${vL.ang + 90} ${vL.cx} ${vL.cy})`} />
  <ellipse class="k w08" cx={vL.cx} cy={vL.cy} rx={vL.rx} ry={vL.ry} transform={`rotate(${vL.ang + 90} ${vL.cx} ${vL.cy})`} />
  <path class="bg" d={art.body} />
  <path class="k w04" d={int(artH)} clip-path={`url(#${uid}-ar)`} />
  <path class="k w10" d={art.top + art.bot} />
  <ellipse class="bg" cx={aL.cx} cy={aL.cy} rx={aL.rx} ry={aL.ry} transform={`rotate(${aL.ang + 90} ${aL.cx} ${aL.cy})`} />
  <ellipse class="k w10" cx={aL.cx} cy={aL.cy} rx={aL.rx} ry={aL.ry} transform={`rotate(${aL.ang + 90} ${aL.cx} ${aL.cy})`} />

  <!-- the metastatic focus -->
  <path class="a" style="stroke-width:2.6" d={dots(metCells.filter((_, i) => i % 3 === 0))} />
  <path class="a" style="stroke-width:1.7" d={dots(metCells.filter((_, i) => i % 3 !== 0))} />
  <circle class="a w05" cx={M[0]} cy={M[1]} r="21" />
  <path class="a w05" d={`M${M[0] + 15} ${M[1] - 15}L${M[0] + 44} ${M[1] - 44}h8`} />
  <text class="lbl-a" x={M[0] + 56} y={M[1] - 41}>metastatic focus</text>

  <!-- callouts -->
  <path class="k w04" d={`M${capP[0] - 2} ${capP[1] - 2}L${capP[0] - 30} ${capP[1] - 30}h-6`} />
  <text class="lbl-k" x={capP[0] - 40} y={capP[1] - 27} text-anchor="end">a. capsule</text>
  <path class="k w04" d={`M${folB.c[0] - 8} ${folB.c[1] + 18}L${folB.c[0] - 30} ${folB.c[1] + 52}h-6`} />
  <text class="lbl-k" x={folB.c[0] - 40} y={folB.c[1] + 55} text-anchor="end">b. follicle</text>
  <path class="k w04" d={`M${medP[0]} ${medP[1]}L${medP[0] - 4} ${medP[1] + 128}`} />
  <text class="lbl-k" x={medP[0] - 4} y={medP[1] + 140} text-anchor="middle">c. medulla</text>
  <path class="k w04" d={`M${H[0] + 2} ${H[1] + 1}L${H[0] + 40} ${H[1] + 56}h8`} />
  <text class="lbl-k" x={H[0] + 52} y={H[1] + 59}>d. hilum</text>

  <!-- scale -->
  <path class="k w05" d={wobble([scaleX, scaleY], [scaleX + scaleW, scaleY], R, 0.25, 3) + `M${scaleX} ${scaleY - 3}v6M${scaleX + scaleW} ${scaleY - 3}v6M${scaleX + scaleW / 2} ${scaleY - 2}v4`} />
  <text class="lbl" x={scaleX + scaleW / 2} y={scaleY + 13} text-anchor="middle">schematic</text>
</Frame>
