---
import { render } from 'astro:content';
import Engraving from './Engraving.astro';
import Taxonomy from './Taxonomy.astro';
import { hrefOf, slugOf, type Plate } from '../lib/plates';

interface Props { plate: Plate; prev?: Plate; next?: Plate }
const { plate, prev, next } = Astro.props;
const d = plate.data;
const slug = slugOf(plate);
const { Content } = await render(plate);
---
<article class="plate page page-top" aria-labelledby="plate-title">
  <header class="plate__head">
    <p class="plate__num" data-reveal>
      <span class="label">Plate</span>
      <span class="plate__numeral">{d.numeral}</span>
    </p>
    <div class="plate__titles">
      <h1 id="plate-title" data-reveal style="--i:1">{d.title}</h1>
      <div class="plate__tax" data-reveal style="--i:2"><Taxonomy plate={plate} observed={false} /></div>
    </div>
    <dl class="plate__record mono" data-reveal style="--i:3">
      <div><dt>Observed</dt><dd>{d.period}</dd></div>
      {d.team && <div><dt>Collected by</dt><dd>{d.team === 'solo' ? 'J. Bernardi' : 'J. Bernardi, in a team of four'}</dd></div>}
      <div><dt>Domain</dt><dd>{d.domain}</dd></div>
      {d.links.length > 0 && (
        <div><dt>Sources</dt><dd><ul role="list">{d.links.map((l) => <li><a href={l.href}>{l.label}&nbsp;↗</a></li>)}</ul></dd></div>
      )}
    </dl>
  </header>

  <div class="rule plate__rule" data-draw></div>

  <figure class="plate__figure">
    <div class="plate__engraving crop" style={`view-transition-name: plate-${slug}`}>
      <Engraving name={d.engraving} title={d.figAlt} desc={d.figCaption} />
    </div>
    <figcaption class="mono"><span class="ink">Fig. {d.numeral}.</span> {d.figCaption}</figcaption>
  </figure>

  <section class="plate__abstract" aria-labelledby="abstract-h">
    <h2 id="abstract-h" class="label">Abstract</h2>
    <p class="lead">{d.abstract}</p>
  </section>

  <div class="plate__body prose">
    <Content />
  </div>

  {d.results.length > 0 && (
    <section class="plate__measures" aria-labelledby="measures-h">
      <h2 id="measures-h" class="label">Table {d.numeral}. Measurements</h2>
      <table>
        <thead><tr><th scope="col">Specimen</th><th scope="col">Value</th><th scope="col" class="plate__note-col">Note</th></tr></thead>
        <tbody>
          {d.results.map((r) => (
            <tr class:list={{ best: r.best }}>
              <th scope="row">{r.label}</th>
              <td class="num">{r.value}</td>
              <td class="plate__note-col soft">{r.note ?? ''}</td>
            </tr>
          ))}
        </tbody>
      </table>
      {d.resultsCaption && <p class="mono soft plate__tcap">{d.resultsCaption}</p>}
    </section>
  )}

  <section class="plate__stack" aria-labelledby="stack-h">
    <h2 id="stack-h" class="label">Instruments used</h2>
    <ul role="list" class="tags">{d.stack.map((s) => <li class="tag">{s}</li>)}</ul>
  </section>

  {(prev || next) && (
    <nav class="plate-nav" aria-label="Adjacent plates">
      {prev ? (
        <a class="plate-nav__a" href={hrefOf(prev)} rel="prev" data-prev>
          <span class="label">← Plate {prev.data.numeral}</span>
          <span class="plate-nav__t">{prev.data.short}</span>
        </a>
      ) : <span />}
      <a class="plate-nav__all label" href="/work/">All plates</a>
      {next ? (
        <a class="plate-nav__a plate-nav__a--next" href={hrefOf(next)} rel="next" data-next>
          <span class="label">Plate {next.data.numeral} →</span>
          <span class="plate-nav__t">{next.data.short}</span>
        </a>
      ) : <span />}
    </nav>
  )}
</article>

<style>
  .plate { row-gap: 0; }
  .plate__head { display: grid; grid-template-columns: subgrid; grid-column: 1 / -1; align-items: start; row-gap: var(--s-5); }
  .plate__num { grid-column: 1 / span 1; display: grid; gap: .2rem; padding-top: .6rem; }
  .plate__numeral { font-family: var(--f-display); font-size: clamp(2.4rem, 1.6rem + 2.4vw, 4rem); line-height: .9; font-weight: 300; color: var(--accent); font-variation-settings: 'opsz' 144; }
  .plate__titles { grid-column: 2 / span 7; display: grid; gap: var(--s-5); }
  .plate__titles h1 { font-size: clamp(2.4rem, 1.6rem + 3.4vw, 5.2rem); }
  .plate__record { grid-column: 10 / -1; display: grid; gap: .7rem; font-size: .75rem; padding-top: .8rem; border-top: var(--hair) solid var(--ink); }
  .plate__record div { display: grid; grid-template-columns: 6.5rem 1fr; gap: .5rem; }
  .plate__record dt { color: var(--ink-soft); text-transform: uppercase; letter-spacing: .1em; font-size: .66rem; padding-top: .12em; }
  .plate__record ul { display: grid; gap: .25rem; }
  .plate__record li a { display: inline-block; padding-block: .3rem; min-height: 24px; }
  .plate__record a { text-decoration-color: var(--accent); }
  .plate__rule { grid-column: 1 / -1; margin-block: var(--s-7) var(--s-7); }

  .plate__figure { grid-column: 2 / span 10; display: grid; gap: var(--s-4); margin-bottom: var(--s-8); }
  .plate__figure figcaption { font-size: .75rem; color: var(--ink-soft); max-width: 70ch; }
  .plate__figure .ink { color: var(--ink); }

  .plate__abstract { grid-column: 1 / -1; display: grid; grid-template-columns: subgrid; margin-bottom: var(--s-7); }
  .plate__abstract h2 { grid-column: 1 / span 1; padding-top: .7rem; }
  .plate__abstract .lead { grid-column: 2 / span 7; }

  .plate__body { grid-column: 2 / span 7; max-width: none; }

  .plate__measures, .plate__stack { grid-column: 2 / span 7; margin-top: var(--s-8); }
  .plate__measures h2, .plate__stack h2 { margin-bottom: var(--s-4); }
  .plate__measures table { width: 100%; font-size: var(--t-small); }
  .plate__measures th, .plate__measures td { text-align: left; padding: .6rem .8rem .6rem 0; border-bottom: var(--hair) solid var(--rule); vertical-align: baseline; }
  .plate__measures thead th { font: 400 .66rem/1.2 var(--f-mono); text-transform: uppercase; letter-spacing: .1em; color: var(--ink-soft); border-bottom-color: var(--ink); }
  .plate__measures tbody th { font-weight: 400; }
  .plate__measures td.num { font-size: .82rem; white-space: nowrap; }
  .plate__measures tr.best th, .plate__measures tr.best td.num { color: var(--accent); }
  .plate__measures tr.best td.num { font-weight: 500; }
  .plate__note-col { font: 400 .72rem/1.4 var(--f-mono); }
  .plate__tcap { margin-top: var(--s-3); font-size: .72rem; max-width: 70ch; }
  .plate__stack .tags { gap: .45rem; }

  .plate-nav { grid-column: 1 / -1; margin-top: var(--s-9); display: grid; grid-template-columns: 1fr auto 1fr; align-items: start; gap: var(--s-5); border-top: var(--hair) solid var(--ink); padding-top: var(--s-5); }
  .plate-nav__a { display: grid; gap: .4rem; text-decoration: none; }
  .plate-nav__a--next { text-align: right; }
  .plate-nav__t { font-family: var(--f-display); font-size: var(--t-h3); line-height: 1.1; transition: color var(--dur-1) var(--ease); }
  .plate-nav__a:hover .plate-nav__t { color: var(--accent); font-style: italic; }
  .plate-nav__all { text-decoration: none; color: var(--ink-soft); }
  .plate-nav__all:hover { color: var(--accent); }

  @media (max-width: 860px) {
    .plate__head, .plate__abstract { display: block; }
    .plate__num { display: flex; align-items: baseline; gap: .8rem; margin-bottom: var(--s-4); }
    .plate__record { margin-top: var(--s-6); }
    .plate__abstract h2 { margin-bottom: var(--s-3); }
    .plate__figure, .plate__body, .plate__measures, .plate__stack { grid-column: 1 / -1; }
    .plate__note-col { display: none; }
    .plate-nav { grid-template-columns: 1fr 1fr; }
    .plate-nav__all { display: none; }
  }
</style>
