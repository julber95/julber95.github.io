---
import type { Plate } from '../lib/plates';
interface Props { plate: Plate; compact?: boolean; observed?: boolean }
const { plate, compact = false, observed = true } = Astro.props;
const d = plate.data;
---
<p class:list={['taxonomy', { 'taxonomy--compact': compact }]}>
  <span class="taxonomy__name taxon">{d.taxon}</span>
  <span class="taxonomy__meta mono">
    <span><span class="soft">Family</span> {d.family}</span>
    {!compact && <span><span class="soft">Habitat</span> {d.habitat}</span>}
    {observed && <span><span class="soft">Observed</span> {d.observed}</span>}
  </span>
</p>
<style>
  .taxonomy { display: flex; flex-wrap: wrap; align-items: baseline; gap: .35rem 1rem; }
  .taxonomy__name { font-size: 1.2em; }
  .taxonomy__meta { display: flex; flex-wrap: wrap; gap: .2rem 0; font-size: .72rem; letter-spacing: .03em; }
  .taxonomy__meta > span { white-space: nowrap; }
  .taxonomy__meta > span:not(:last-child)::after { content: '·'; margin-inline: .6em; color: var(--ink-soft); }
  @media (max-width: 860px) {
    .taxonomy__meta { display: grid; gap: .15rem; width: 100%; }
    .taxonomy__meta > span:not(:last-child)::after { content: none; }
    .taxonomy__meta > span { white-space: normal; }
  }
  .taxonomy__meta .soft { text-transform: uppercase; letter-spacing: .1em; font-size: .66rem; margin-right: .25em; }
</style>
