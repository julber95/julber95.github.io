---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Engraving from '../../components/Engraving.astro';
import { getPlates, hrefOf, slugOf } from '../../lib/plates';

const plates = (await getPlates()).slice().reverse(); // newest plate first
const instruments = (await getCollection('instruments')).sort((a, b) => a.data.letter.localeCompare(b.data.letter));
const domains = ['Generative', 'NLP', 'Medical', 'Tabular'] as const;
const count = (d: string) => plates.filter((p) => p.data.domain === d).length;
---
<Base title="Plates" description="The full catalogue: seven plates of machine-learning models taken apart, plus the instruments I built along the way.">
  <div class="page page-top work">
    <header class="work__head">
      <p class="label" data-reveal>§2 · Catalogue</p>
      <h1 data-reveal style="--i:1">Plates <em>I–VII</em>, and two instruments</h1>
      <p class="work__intro soft" data-reveal style="--i:2">
        Each plate is one model studied closely: the problem it was set, how it was built, and what it actually scored.
        Numbered in the order they were made.
      </p>
    </header>

    <div class="work__controls" data-reveal style="--i:3">
      <fieldset class="filters">
        <legend class="label">Domain</legend>
        <button type="button" class="chip" aria-pressed="true" data-filter="all">All <span class="num">{plates.length + instruments.length}</span></button>
        {domains.map((d) => (
          <button type="button" class="chip" aria-pressed="false" data-filter={d}>{d} <span class="num">{count(d)}</span></button>
        ))}
        <button type="button" class="chip" aria-pressed="false" data-filter="Instruments">Instruments <span class="num">{instruments.length}</span></button>
      </fieldset>
      <div class="views" role="group" aria-label="View">
        <button type="button" class="view-btn label" aria-pressed="true" data-view="grid">Plates</button>
        <span aria-hidden="true" class="soft">/</span>
        <button type="button" class="view-btn label" aria-pressed="false" data-view="ledger">Ledger</button>
      </div>
    </div>

    <p class="sr-only" aria-live="polite" data-live></p>

    <!-- grid view -->
    <ol class="grid" role="list" data-grid>
      {plates.map((p, i) => (
        <li class="card" data-domain={p.data.domain} style={`--i:${i % 3}`} data-reveal>
          <a class="card__a" href={hrefOf(p)}>
            <div class="card__fig crop" style={`view-transition-name: plate-${slugOf(p)}`}>
              <Engraving name={p.data.engraving} title={p.data.figAlt} desc={p.data.figCaption} decorative />
            </div>
            <div class="card__meta mono">
              <span class="card__no">Pl. {p.data.numeral}</span>
              <span>{p.data.domain}</span>
              <span>{p.data.observed}</span>
            </div>
            <h2 class="card__title">{p.data.title}</h2>
            <p class="card__taxon taxon">{p.data.taxon}</p>
          </a>
        </li>
      ))}
    </ol>

    <!-- ledger view -->
    <div class="ledger-wrap" data-ledger hidden>
      <table class="ledger">
        <caption class="sr-only">Ledger of plates</caption>
        <thead>
          <tr><th scope="col">No.</th><th scope="col">Name</th><th scope="col">Domain</th><th scope="col">Year</th><th scope="col">Stack</th></tr>
        </thead>
        <tbody>
          {plates.map((p) => (
            <tr data-domain={p.data.domain}>
              <td class="mono ledger__no">{p.data.numeral}</td>
              <th scope="row"><a href={hrefOf(p)}>{p.data.title}</a><span class="taxon soft ledger__tax">{p.data.taxon}</span></th>
              <td class="mono">{p.data.domain}</td>
              <td class="mono">{p.data.observed}</td>
              <td class="mono soft ledger__stack">{p.data.stack.slice(0, 4).join(', ')}</td>
            </tr>
          ))}
          {instruments.map((x) => (
            <tr data-domain="Instruments">
              <td class="mono ledger__no">{x.data.letter}</td>
              <th scope="row"><a href={x.data.links[0]?.href}>{x.data.title}</a><span class="taxon soft ledger__tax">{x.data.kind}</span></th>
              <td class="mono">Instrument</td>
              <td class="mono">{x.data.period}</td>
              <td class="mono soft ledger__stack">{x.data.stack.slice(0, 4).join(', ')}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- appendices -->
    <section class="appx" aria-labelledby="appx-h" data-appx>
      <header class="section-head">
        <span class="label">Appendices</span>
        <h2 id="appx-h">Instruments <em>I built</em></h2>
        <span class="aside label">Not specimens: tools</span>
      </header>
      <ol class="appx__list" role="list">
        {instruments.map((x) => (
          <li class="appx__item">
            <span class="appx__letter">{x.data.letter}</span>
            <div class="appx__body">
              <h3>{x.data.title} <span class="soft appx__kind">{x.data.kind}</span></h3>
              <p>{x.data.summary}</p>
              <ul role="list" class="tags">{x.data.stack.map((s) => <li class="tag">{s}</li>)}</ul>
            </div>
            <ul role="list" class="appx__links mono">
              {x.data.links.map((l) => <li><a href={l.href}>{l.label}&nbsp;↗</a></li>)}
            </ul>
          </li>
        ))}
      </ol>
    </section>
  </div>
</Base>

<script>
  const grid = document.querySelector<HTMLElement>('[data-grid]')!;
  const ledger = document.querySelector<HTMLElement>('[data-ledger]')!;
  const appx = document.querySelector<HTMLElement>('[data-appx]')!;
  const live = document.querySelector<HTMLElement>('[data-live]')!;
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const views = [...document.querySelectorAll<HTMLButtonElement>('[data-view]')];
  let filter = 'all';
  let view: 'grid' | 'ledger' = 'grid';
  try { const v = localStorage.getItem('atlas-view'); if (v === 'ledger' || v === 'grid') view = v; } catch {}
  try { const f = new URL(location.href).searchParams.get('domain'); if (f && chips.some((c) => c.dataset.filter === f)) filter = f; } catch {}

  function apply() {
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.filter === filter)));
    views.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === view)));
    const instrOnly = filter === 'Instruments';
    grid.hidden = view !== 'grid' || instrOnly;
    ledger.hidden = view !== 'ledger';
    appx.hidden = view === 'ledger' || !(filter === 'all' || instrOnly);
    let n = 0;
    document.querySelectorAll<HTMLElement>('[data-domain]').forEach((el) => {
      const show = filter === 'all' || el.dataset.domain === filter;
      el.hidden = !show;
      if (show && el.closest(view === 'grid' ? '[data-grid]' : '[data-ledger]')) n++;
      if (show) el.classList.add('is-in');
    });
    if (view === 'grid' && instrOnly) n = appx.querySelectorAll('.appx__item').length;
    live.textContent = `${n} ${n === 1 ? 'entry' : 'entries'} shown`;
  }
  chips.forEach((c) => c.addEventListener('click', () => {
    filter = c.dataset.filter!;
    const u = new URL(location.href);
    filter === 'all' ? u.searchParams.delete('domain') : u.searchParams.set('domain', filter);
    history.replaceState(null, '', u);
    apply();
  }));
  views.forEach((b) => b.addEventListener('click', () => {
    view = b.dataset.view as 'grid' | 'ledger';
    try { localStorage.setItem('atlas-view', view); } catch {}
    apply();
  }));
  apply();
</script>

<style>
  .work__head { grid-column: 2 / span 9; display: grid; gap: var(--s-5); margin-bottom: var(--s-8); }
  .work__head h1 { font-size: clamp(2.6rem, 1.6rem + 4vw, 6rem); }
  .work__intro { max-width: 54ch; font-size: var(--t-lead); font-family: var(--f-display); line-height: 1.35; font-weight: 340; }

  .work__controls { grid-column: 1 / -1; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--s-4); padding-block: var(--s-4); border-block: var(--hair) solid var(--ink); margin-bottom: var(--s-8); }
  .filters { border: 0; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .4rem .4rem; align-items: center; }
  .filters legend { float: left; margin-right: .8rem; padding: 0; }
  .chip { font: 400 .75rem/1 var(--f-mono); letter-spacing: .04em; padding: .55rem .15rem .5rem; margin-right: .9rem; color: var(--ink-soft); border-bottom: var(--hair) solid transparent; transition: color var(--dur-1) var(--ease), border-color var(--dur-1) var(--ease); }
  .chip .num { color: var(--ink-soft); margin-left: .2rem; }
  .chip:hover { color: var(--ink); }
  .chip[aria-pressed='true'] { color: var(--ink); border-bottom-color: var(--accent); }
  .chip[aria-pressed='true'] .num { color: var(--accent); }
  .views { display: flex; gap: .6rem; align-items: center; }
  .view-btn { color: var(--ink-soft); padding: .4rem 0; }
  .view-btn[aria-pressed='true'] { color: var(--ink); text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: .4em; }

  .grid { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: var(--s-8); }
  .card { grid-column: span 4; content-visibility: auto; contain-intrinsic-size: auto 520px; }
  .card:nth-child(3n + 2) { margin-top: var(--s-8); }
  .card:nth-child(3n + 3) { margin-top: var(--s-5); }
  .card:first-child { grid-column: span 8; }
  .card:first-child + .card { margin-top: 0; }
  .card:first-child .card__title { font-size: var(--t-h2); }
  .card__a { display: grid; gap: var(--s-3); text-decoration: none; }
  .card__fig { margin-bottom: var(--s-3); transition: transform var(--dur-3) var(--ease); }
  .card__a:hover .card__fig { transform: translateY(-3px); }
  .card__meta { display: flex; gap: 1rem; font-size: .7rem; color: var(--ink-soft); text-transform: uppercase; letter-spacing: .1em; }
  .card__no { color: var(--accent); }
  .card__title { font-size: var(--t-h3); line-height: 1.12; transition: color var(--dur-1) var(--ease); }
  .card__a:hover .card__title { font-style: italic; }
  .card__taxon { color: var(--ink-soft); }

  .ledger-wrap { grid-column: 1 / -1; overflow-x: auto; }
  .ledger { width: 100%; font-size: var(--t-small); min-width: 640px; }
  .ledger thead th { font: 400 .66rem/1 var(--f-mono); text-transform: uppercase; letter-spacing: .12em; color: var(--ink-soft); text-align: left; padding: 0 1rem .7rem 0; border-bottom: var(--hair) solid var(--ink); }
  .ledger td, .ledger tbody th { padding: .95rem 1rem .95rem 0; border-bottom: var(--hair) solid var(--rule); text-align: left; vertical-align: baseline; font-weight: 400; }
  .ledger tbody th a { font-family: var(--f-display); font-size: 1.2rem; text-decoration: none; }
  .ledger tbody th a:hover { color: var(--accent); }
  .ledger__tax { display: block; font-size: .9rem; margin-top: .15rem; }
  .ledger__no { color: var(--accent); width: 3.5rem; }
  .ledger td.mono { font-size: .75rem; }
  .ledger tbody tr:hover th a { font-style: italic; }

  .appx { grid-column: 1 / -1; display: grid; grid-template-columns: subgrid; margin-top: var(--s-9); }
  .appx__list { grid-column: 1 / -1; display: grid; grid-template-columns: subgrid; }
  .appx__item { grid-column: 1 / -1; display: grid; grid-template-columns: subgrid; padding-block: var(--s-6); border-bottom: var(--hair) solid var(--rule); align-items: start; }
  .appx__letter { grid-column: 1 / span 1; font-family: var(--f-display); font-size: 3rem; font-weight: 300; font-style: italic; line-height: .9; color: var(--accent); }
  .appx__body { grid-column: 2 / span 7; display: grid; gap: var(--s-3); }
  .appx__body h3 { font-size: var(--t-h3); }
  .appx__kind { font: 400 .75rem/1 var(--f-mono); letter-spacing: .06em; margin-left: .5rem; font-style: normal; }
  .appx__body p { max-width: 62ch; }
  .appx__links { grid-column: 10 / -1; display: grid; gap: .4rem; font-size: .78rem; padding-top: .5rem; }

  @media (max-width: 1100px) {
    .card, .card:first-child { grid-column: span 6; margin-top: 0 !important; }
  }
  @media (max-width: 860px) {
    .work__head { grid-column: 1 / -1; }
    .grid { grid-template-columns: 1fr; row-gap: var(--s-7); }
    .card, .card:first-child { grid-column: 1 / -1; }
    .appx, .appx__list, .appx__item { display: block; }
    .appx__letter { display: block; margin-bottom: var(--s-3); }
    .appx__links { margin-top: var(--s-4); }
    .views { margin-left: auto; }
  }
</style>
