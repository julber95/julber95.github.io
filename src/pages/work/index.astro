---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Engraving from '../../components/Engraving.astro';
import { getPlates, hrefOf, slugOf } from '../../lib/plates';
import { capitalise, numberWord } from '../../lib/words';

const plates = (await getPlates()).slice().reverse(); // newest first
const instruments = (await getCollection('instruments')).sort((a, b) => a.data.order - b.data.order);
const domains = ['Generative', 'NLP', 'Medical', 'Tabular'] as const;
const count = (d: string) => plates.filter((p) => p.data.domain === d).length;
const nWord = numberWord(plates.length);
---
<Base title="Work" description={`${capitalise(nWord)} machine-learning projects taken apart, from GANs and decoding to medical imaging and explainable NLP, plus two tools I built.`}>
  <div class="page page-top work">
    <header class="work__head">
      <p class="label" data-reveal>Work</p>
      <h1 data-reveal style="--i:1">Models I have <em>taken apart</em></h1>
      <p class="work__intro soft" data-reveal style="--i:2">{capitalise(nWord)} projects, newest first: what each model was set to do, how it was built, and what it actually scored.</p>
    </header>

    <div class="work__controls" data-reveal style="--i:3">
      <fieldset class="filters">
        <legend class="sr-only">Filter by domain</legend>
        <button type="button" class="tab" aria-pressed="true" data-filter="all">All <span class="num">{plates.length}</span></button>
        {domains.map((d) => (
          <button type="button" class="tab" aria-pressed="false" data-filter={d}>{d} <span class="num">{count(d)}</span></button>
        ))}
      </fieldset>
    </div>
    <p class="sr-only" aria-live="polite" data-live></p>

    <ol class="list" role="list">
      {plates.map((p) => (
        <li class="item" data-domain={p.data.domain}>
          <a class="item__a" href={hrefOf(p)}>
            <div class="item__fig" style={`view-transition-name: plate-${slugOf(p)}`}>
              <Engraving name={p.data.engraving} title={p.data.figAlt} desc={p.data.figCaption} decorative />
            </div>
            <div class="item__text">
              <h2 class="item__title">{p.data.title}</h2>
              <p class="item__summary">{p.data.summary}</p>
            </div>
            <p class="item__meta mono"><span>{p.data.domain}</span><span>{p.data.observed}</span></p>
          </a>
        </li>
      ))}
    </ol>

    <section class="appx" aria-labelledby="appx-h">
      <h2 id="appx-h" class="label">Also built: tools</h2>
      <ul role="list" class="appx__list">
        {instruments.map((x) => (
          <li class="appx__item">
            <h3>{x.data.title} <span class="mono soft">{x.data.kind}</span></h3>
            <p class="soft">{x.data.summary}</p>
            <p class="mono appx__links">{x.data.links.map((l, i) => <>{i > 0 && ' · '}<a href={l.href}>{l.label}&nbsp;↗</a></>)}</p>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const items = [...document.querySelectorAll<HTMLElement>('.item')];
  const live = document.querySelector<HTMLElement>('[data-live]')!;
  let filter = 'all';
  try { const f = new URL(location.href).searchParams.get('domain'); if (f && tabs.some((t) => t.dataset.filter === f)) filter = f; } catch {}
  const apply = () => {
    tabs.forEach((t) => t.setAttribute('aria-pressed', String(t.dataset.filter === filter)));
    let n = 0;
    items.forEach((el) => { const show = filter === 'all' || el.dataset.domain === filter; el.hidden = !show; if (show) n++; });
    live.textContent = `${n} ${n === 1 ? 'project' : 'projects'} shown`;
  };
  tabs.forEach((t) => t.addEventListener('click', () => {
    filter = t.dataset.filter!;
    const u = new URL(location.href);
    filter === 'all' ? u.searchParams.delete('domain') : u.searchParams.set('domain', filter);
    history.replaceState(null, '', u);
    apply();
  }));
  apply();
</script>

<style>
  .work__head { grid-column: 1 / span 8; display: grid; gap: var(--s-4); margin-bottom: var(--s-7); }
  .work__head h1 { font-size: clamp(2.4rem, 1.5rem + 3vw, 4.6rem); font-weight: 500; letter-spacing: -0.03em; }
  .work__intro { max-width: 48ch; font-family: var(--f-body); font-size: var(--t-lead); line-height: 1.35; font-weight: 300; }

  .work__controls { grid-column: 1 / -1; border-bottom: var(--hair) solid var(--ink); }
  .filters { border: 0; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0 1.4rem; }
  .tab { font: 400 .75rem/1 var(--f-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--ink-soft); padding: .85rem 0 .75rem; border-bottom: 2px solid transparent; margin-bottom: -1px; }
  .tab .num { margin-left: .25rem; }
  .tab:hover { color: var(--ink); }
  .tab[aria-pressed='true'] { color: var(--ink); border-bottom-color: var(--accent); }

  .list { grid-column: 1 / -1; }
  .item { border-bottom: var(--hair) solid var(--rule); }
  .item__a { display: grid; grid-template-columns: 132px 1fr auto; gap: var(--s-6); align-items: center; padding-block: var(--s-5); text-decoration: none; }
  .item__fig { min-width: 0; }
  /* hairlines vanish at thumbnail size: keep strokes at least ~0.6px on screen */
  .item__fig :global(.engraving :is(.k, .a)) { vector-effect: non-scaling-stroke; stroke-width: max(0.6px, 1px); }
  .item__fig :global(.engraving .fk) { stroke: currentColor; stroke-width: .6px; vector-effect: non-scaling-stroke; }
  .item__text { display: grid; gap: .35rem; }
  .item__title { font-size: var(--t-h3); font-weight: 420; line-height: 1.15; transition: color var(--dur-1) var(--ease); }
  .item__a:hover .item__title { color: var(--accent); }
  .item__summary { color: var(--ink-soft); font-size: var(--t-small); max-width: 70ch; }
  .item__meta { display: grid; gap: .3rem; text-align: right; font-size: .72rem; color: var(--ink-soft); text-transform: uppercase; letter-spacing: .08em; }

  /* cards: thumbnail on top, title, summary, meta */
  @media (min-width: 861px) {
    .list { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: var(--gutter); margin-top: var(--s-6); }
    .item { border: var(--hair) solid var(--rule); border-radius: var(--radius); background: var(--surface); transition: border-color var(--dur-2) var(--ease), transform var(--dur-2) var(--ease); }
    .item:hover { border-color: var(--accent); transform: translateY(-2px); }
    .item__a { grid-template-columns: 1fr; padding: var(--s-5); gap: var(--s-4); align-items: start; height: 100%; }
    .item__meta { text-align: left; display: flex; gap: 1rem; flex-wrap: wrap; }
  }
  .appx { grid-column: 1 / span 8; margin-top: var(--s-8); display: grid; gap: var(--s-4); }
  .appx__list { display: grid; gap: var(--s-5); }
  .appx__item { display: grid; gap: .35rem; }
  .appx__item h3 { font-size: 1.25rem; font-weight: 420; }
  .appx__item h3 .mono { font-size: .72rem; margin-left: .4rem; }
  .appx__item p { font-size: var(--t-small); max-width: 66ch; }
  .appx__links { font-size: .75rem; }
  .appx__links a { text-decoration-color: var(--accent); display: inline-block; padding-block: .2rem; }

  @media (max-width: 860px) {
    .work__head, .appx { grid-column: 1 / -1; }
    .item__a { grid-template-columns: 88px 1fr; gap: var(--s-4); }
    .item__meta { grid-column: 2; text-align: left; display: flex; gap: 1rem; }
  }
</style>
