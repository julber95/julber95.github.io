---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { skills } from '../data/skills';
import { site } from '../data/site';

const entry = (await getEntry('pages', 'about'))!;
const { Content } = await render(entry);
---
<Base person title="About" description="About Julien Bernardi: what draws him to machine learning, the design side, and the tools he works with.">
  <div class="page page-top about">
    <header class="about__head">
      <p class="label" data-reveal>About</p>
      <h1 data-reveal style="--i:1">{entry.data.lede}</h1>
    </header>

    <div class="about__essay prose" data-reveal style="--i:2">
      <Content />
    </div>

    <aside class="about__margin mono" data-reveal style="--i:3">
      <dl>
        <div><dt>Based in</dt><dd>{site.place}</dd></div>
        <div><dt>Currently</dt><dd>{site.status.map((s) => `${s.label} @ ${s.at}`).join(' · ')}</dd></div>
        <div><dt>Languages</dt><dd>French, native · English, C1</dd></div>
        <div><dt>Write to</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
      </dl>
    </aside>

    <section class="skills" aria-labelledby="skills-h">
      <h2 id="skills-h" class="label">Tools &amp; methods</h2>
      <dl class="skills__list">
        {skills.map((g) => (
          <div class="skills__row">
            <dt>{g.group}</dt>
            <dd>{g.items.map((i) => i.name).join(', ')}</dd>
          </div>
        ))}
      </dl>
    </section>
  </div>
</Base>

<style>
  .about__head { grid-column: 1 / span 8; margin-bottom: var(--s-7); display: grid; gap: var(--s-4); }
  .about__head h1 { font-size: clamp(2.4rem, 1.5rem + 3vw, 4.6rem); font-weight: 500; letter-spacing: -0.03em; max-width: 18ch; }
  .about__essay { grid-column: 1 / span 7; font-size: 1.08em; }
  .about__margin { grid-column: 9 / -1; font-size: .75rem; }
  .about__margin dl { display: grid; gap: 1rem; padding-top: .8rem; border-top: var(--hair) solid var(--ink); }
  .about__margin dt { text-transform: uppercase; letter-spacing: .1em; color: var(--ink-soft); font-size: .66rem; margin-bottom: .2rem; }
  .about__margin a { text-decoration-color: var(--accent); }

  .skills { grid-column: 1 / span 8; margin-top: var(--s-8); display: grid; gap: var(--s-4); }
  .skills__list { border-top: var(--hair) solid var(--ink); }
  .skills__row { display: grid; grid-template-columns: 10rem 1fr; gap: 1rem; padding-block: .75rem; border-bottom: var(--hair) solid var(--rule); align-items: baseline; }
  .skills__row dt { font: 400 .7rem/1.4 var(--f-mono); text-transform: uppercase; letter-spacing: .1em; color: var(--ink-soft); }
  .skills__row dd { font-size: var(--t-small); }

  @media (max-width: 860px) {
    .about__head, .about__essay, .about__margin, .skills { grid-column: 1 / -1; }
    .about__margin { margin-top: var(--s-6); }
    .skills__row { grid-template-columns: 1fr; gap: .2rem; }
  }
</style>
