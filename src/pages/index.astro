---
import Base from '../layouts/Base.astro';
import LandscapeFigure from '../components/LandscapeFigure.astro';
import { site } from '../data/site';
import { existsSync } from 'node:fs';
import { getCollection } from 'astro:content';

// "Now": the study and the job that are current today, straight from the Field Log
const today = new Date();
const current = (await getCollection('log'))
  .filter((e) => e.data.start <= today && (!e.data.end || e.data.end >= today))
  .sort((a, b) => (a.data.kind === 'education' ? -1 : 1) - (b.data.kind === 'education' ? -1 : 1));

// drop a square photo at public/portrait.jpeg (or .jpg) and it replaces the initials
// resolved from the project root: import.meta.url points elsewhere once the page is bundled for the build
const portrait = ['portrait.jpeg', 'portrait.jpg'].find((f) => existsSync(`${process.cwd()}/public/${f}`));

---
<Base person>
  <div class="page home">
    <section class="home__intro" aria-labelledby="home-title">
      <p class="label" data-reveal>AI / ML student · Paris</p>
      <div class="home__who" data-reveal style="--i:1">
        {portrait
          ? <img class="home__photo" src={`/${portrait}`} alt="Portrait of Julien Bernardi" width="136" height="136" />
          : <span class="home__photo home__photo--empty" aria-hidden="true">JB</span>}
        <h1 id="home-title" class="home__name">Julien Bernardi</h1>
      </div>
      <p class="home__lead" data-reveal style="--i:2">
        Student at PSL University, and AI engineer at AMIAD.{' '}
        <em>Mostly I want to know how things work.</em>
      </p>
      <div class="home__links" data-reveal style="--i:3">
        <a class="btn btn--primary" href="/projects/">See my projects →</a>
        <a class="btn" href={site.github}>GitHub</a>
        <a class="btn" href={site.linkedin}>LinkedIn</a>
        <a class="btn" href={`mailto:${site.email}`}>Email</a>
      </div>
      <p class="home__now label" data-reveal style="--i:3">
        <span>{site.status.map((s) => `${s.label} @ ${s.at}`).join(' · ')} · Paris region</span>
      </p>
    </section>

    <div class="home__figure" data-reveal style="--i:2">
      <LandscapeFigure />
    </div>

    {current.length > 0 && (
      <section class="home__nowsec" aria-labelledby="now-title" data-reveal style="--i:4">
        <div class="home__nowsec-top">
          <h2 id="now-title" class="home__nowsec-k">Now</h2>
          <div class="home__nowsec-links mono">
            <a class="arrow-link" href="/path/"><span>More details</span><span>→</span></a>
          </div>
        </div>
        <div class="nowsplit">
          {current.map((e, k) => {
            const s0 = e.data.start.getTime(), s1 = e.data.end.getTime();
            const p = Math.max(0, Math.min(1, (today.getTime() - s0) / (s1 - s0)));
            return (
              <>
                {k > 0 && <div class="nowsplit__rule" aria-hidden="true" />}
                <article class="nowcol" data-start={s0} data-end={s1}>
                  <div class="nowcol__head label">
                    <span class="nowcol__verb">{e.data.kind === 'education' ? 'Studying' : 'Working'}</span>
                    <span>{e.data.when} · {e.data.place}</span>
                  </div>
                  <div class="nowcol__bar" role="progressbar" aria-label="Time elapsed" aria-valuemin="0" aria-valuemax="100" aria-valuenow={Math.round(p * 100)}>
                    <i style={`width:${(p * 100).toFixed(1)}%`} />
                  </div>
                  {(() => { const [, name, full] = e.data.org.split(' — ')[0].trim().match(/^(.*?)(?:\s*\((.*)\))?$/)!; return (
                    <h3>{name}{full && <span class="nowcol__full"> ({full})</span>}</h3>
                  ); })()}
                  <p class="nowcol__title">{e.data.title.replace(/\s*\(IASD\)/, '')}</p>
                  {e.data.org.includes(' — ') && <p class="nowcol__desc">{e.data.org.split(' — ').slice(1).join(' — ')}</p>}
                </article>
              </>
            );
          })}
        </div>
      </section>
    )}

  </div>
</Base>

<script>
  // the bars reflect today's date, not the build date
  const now = Date.now();
  document.querySelectorAll<HTMLElement>('.nowcol').forEach((c) => {
    const a = +c.dataset.start!, b = +c.dataset.end!, p = Math.max(0, Math.min(1, (now - a) / (b - a)));
    const bar = c.querySelector<HTMLElement>('.nowcol__bar');
    bar?.setAttribute('aria-valuenow', String(Math.round(p * 100)));
    const i = bar?.querySelector<HTMLElement>('i'); if (i) i.style.width = `${(p * 100).toFixed(1)}%`;
  });

</script>

<style>
  .home {
    max-width: 1180px;
    padding-top: clamp(5.5rem, 10vh, 7.5rem);
    padding-bottom: var(--s-6);
    row-gap: var(--s-6);
    align-items: center;
  }
  .home__intro { grid-column: 1 / span 6; display: grid; gap: var(--s-5); align-content: center; }
  .home__name {
    font-size: clamp(2rem, 1rem + 2.2vw, 3.1rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 0.95;
  }
  .home__who { display: flex; align-items: center; gap: var(--s-5); }
  .home__photo { width: clamp(96px, 9vw, 136px); height: clamp(96px, 9vw, 136px); border-radius: 50%; object-fit: cover; flex: none; border: var(--hair) solid var(--rule); background: var(--surface); }
  .home__photo--empty { display: grid; place-items: center; font-family: var(--f-display); font-size: 1.5rem; font-weight: 500; line-height: 1; letter-spacing: -.03em; color: var(--ink-soft); }
  .home__links { display: flex; flex-wrap: wrap; gap: .6rem; }
  .btn { font: 500 .78rem/1 var(--f-mono); letter-spacing: .04em; text-decoration: none; padding: .7rem 1rem; border: var(--hair) solid var(--rule); border-radius: 999px; color: var(--ink); background: var(--surface); transition: border-color var(--dur-1) var(--ease), color var(--dur-1) var(--ease), filter var(--dur-1) var(--ease); }
  .btn:hover { border-color: var(--accent); color: var(--accent); }
  .btn--primary { background: var(--accent); border-color: var(--accent); color: var(--bg); }
  .btn--primary:hover { color: var(--bg); filter: brightness(1.1); }
  .home__lead { font-family: var(--f-body); font-size: clamp(1.3rem, 1.05rem + 0.8vw, 1.75rem); font-weight: 300; line-height: 1.32; max-width: 30ch; }
  .home__lead em { color: var(--accent); }
  .home__now { display: flex; flex-wrap: wrap; gap: .3rem 1.2rem; padding-top: var(--s-4); border-top: var(--hair) solid var(--rule); max-width: 34rem; }
  .home__figure { grid-column: 8 / -1; justify-self: end; width: min(100%, calc(100svh - 21rem)); min-width: 300px; }

  .home__nowsec { grid-column: 1 / -1; display: grid; gap: var(--s-4); padding: var(--s-5) var(--s-6); background: color-mix(in srgb, var(--accent) 7%, var(--bg)); border-left: 3px solid var(--accent); border-radius: 0 14px 14px 0; }
  .home__nowsec-top { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
  .home__nowsec-k { font: 500 1.6rem/1 var(--f-display); letter-spacing: -.02em; color: var(--ink); }
  .home__nowsec-links { display: flex; gap: 1.6rem; }
  .nowsplit { display: grid; grid-template-columns: 1fr 1px 1fr; gap: var(--s-6); }
  .nowsplit__rule { background: var(--rule); }
  .nowcol { display: grid; gap: .3rem; align-content: start; container-type: inline-size; }
  .nowcol__head { display: flex; justify-content: space-between; gap: 1rem; }
  .nowcol__verb { color: var(--accent); }
  .nowcol__bar { height: 3px; border-radius: 3px; background: var(--rule); overflow: hidden; margin: .1rem 0 .35rem; }
  .nowcol__bar i { display: block; height: 100%; border-radius: 3px; background: var(--accent); }
  .nowcol h3 { text-wrap: wrap; font-size: clamp(1.35rem, 1.05rem + .8vw, 1.75rem); font-weight: 500; letter-spacing: -.025em; line-height: 1.1; }
  .nowcol__full { font-family: var(--f-body); font-size: clamp(1.1rem, .95rem + .5vw, 1.4rem); font-weight: 400; letter-spacing: -.01em; line-height: 1.25; color: var(--ink); }
  /* the master's title fills its column on one line (its width is ~26 × its font size); both titles share the size */
  .nowcol__title { font-size: max(.875rem, 3.75cqi); font-weight: 500; line-height: 1.25; letter-spacing: -.005em; }
  .nowcol__desc { font-size: .82rem; line-height: 1.45; color: var(--ink-soft); }

  @media (max-width: 1100px) {
    .home__intro { grid-column: 1 / span 7; }
    .home__figure { grid-column: 8 / -1; justify-self: end; width: min(100%, calc(100svh - 21rem)); min-width: 300px; }
  }
  @media (max-width: 860px) {
    .home { padding-top: 5.5rem; }
    .home__intro, .home__figure { grid-column: 1 / -1; }
    .home__figure { order: 3; width: 100%; min-width: 0; justify-self: stretch; }
    .home__nowsec { order: 2; padding: var(--s-5); }
    .home__nowsec-links { gap: 1.2rem; }
    .nowsplit { grid-template-columns: 1fr; gap: var(--s-5); }
    .nowsplit__rule { height: 1px; }
  }
</style>
