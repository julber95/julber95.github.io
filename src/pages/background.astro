---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const entries = (await getCollection('log')).sort((a, b) => b.data.start.getTime() - a.data.start.getTime());
const now = new Date();
const rendered = await Promise.all(entries.map(async (e) => ({
  e,
  Content: (await render(e)).Content,
  hasBody: !!e.body?.trim(),
  current: e.data.start <= now && e.data.end >= now,
})));
// two columns: studies and work
const columns = [
  { key: 'education', title: 'Education', items: rendered.filter((r) => r.e.data.kind === 'education') },
  { key: 'experience', title: 'Experience', items: rendered.filter((r) => r.e.data.kind === 'experience') },
];
// the org line keeps the institution; a "— details" tail becomes the first line of the details
const splitOrg = (org: string) => {
  const [name, ...rest] = org.split(' — ');
  const detail = rest.join(' — ').trim();
  // short tails (e.g. "PSL") stay on the org line
  return detail.length > 20 ? { name: name!.trim(), detail } : { name: org, detail: '' };
};
---
<Base title="Background" description="Education and work, from Paris-Dauphine to Université PSL, INSEE and AMIAD.">
  <div class="page page-top bg">
    <header class="bg__head">
      <p class="label" data-reveal>Background</p>
      <h1 data-reveal style="--i:1">Education <em>&amp; experience</em></h1>
      <p class="bg__intro soft" data-reveal style="--i:2">
        From a double bachelor’s at Dauphine to a master’s at PSL, with internships at LIFAT and INSEE and a
        work-study year at AMIAD.
      </p>
      <p class="bg__print no-print mono" data-reveal style="--i:3">
        CV <a href="/cv-en.pdf">English</a> · <a href="/cv-fr.pdf" hreflang="fr">Français</a> (PDF) · open a line for details
      </p>
    </header>

    <p class="print-only bg__printhead">
      {site.name} · {site.email} · {site.github.replace('https://', '')} · {site.linkedin.replace('https://www.', '')}
    </p>

    <div class="cv" data-reveal style="--i:4">
      {columns.map((col) => (
        <section class="cv__col" aria-labelledby={`cv-${col.key}`}>
          <h2 class="cv__h" id={`cv-${col.key}`}>{col.title} <span class="cv__n">{col.items.length}</span></h2>
          {col.items.map(({ e, Content, hasBody, current }, i) => {
            const d = e.data;
            const org = splitOrg(d.org);
            return (
              <details class:list={['cv__item', { 'cv__item--now': current }]} open={i === 0}>
                <summary>
                  <span class="cv__sign" aria-hidden="true"></span>
                  <span class="cv__main">
                    {current && <span class="cv__now">Now</span>}
                    <span class="cv__title">{d.title}</span>
                    <span class="cv__org">{org.name}</span>
                  </span>
                  <span class="cv__side mono">
                    <span>{d.when}</span>
                    <span class="soft">{d.place}</span>
                  </span>
                </summary>
                <div class="cv__more">
                  {org.detail && <p class="cv__detail">{org.detail}</p>}
                  {hasBody && <div class="cv__text"><Content /></div>}
                  {d.courses.length > 0 && (
                    <div class="cv__block">
                      <p class="label">Coursework</p>
                      <ul class="cv__chips" role="list">{d.courses.map((c) => <li>{c}</li>)}</ul>
                    </div>
                  )}
                </div>
              </details>
            );
          })}
        </section>
      ))}
    </div>

    <section class="bg__lang" aria-labelledby="lang-h">
      <h2 id="lang-h" class="label">Languages</h2>
      <p>French <span class="soft mono">native</span> · English <span class="soft mono">C1</span></p>
    </section>
  </div>
</Base>

<style>
  .bg__head { grid-column: 1 / span 9; display: grid; gap: var(--s-5); margin-bottom: var(--s-8); }
  .bg__head h1 { font-size: clamp(2.4rem, 1.5rem + 3vw, 4.6rem); font-weight: 500; letter-spacing: -0.03em; }
  .bg__intro { max-width: 56ch; font-size: var(--t-lead); line-height: 1.35; font-weight: 300; }
  .bg__print { font-size: .75rem; color: var(--ink-soft); }
  .bg__print a { text-decoration-color: var(--accent); color: var(--ink); }

  .cv { grid-column: 1 / -1; display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .cv__h {
    display: flex; align-items: baseline; gap: .7rem; padding-bottom: var(--s-4); border-bottom: 2px solid var(--ink);
    font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2.3rem); font-weight: 500; letter-spacing: -.03em;
  }
  .cv__n { font: 400 .8rem/1 var(--f-mono); color: var(--accent); letter-spacing: .04em; }

  .cv__item { border-bottom: var(--hair) solid var(--rule); }
  .cv__item summary {
    list-style: none; cursor: pointer; display: grid; grid-template-columns: 1.4rem 1fr auto; gap: .2rem 1rem;
    align-items: start; padding: var(--s-5) 0;
  }
  .cv__item summary::-webkit-details-marker { display: none; }
  .cv__sign { position: relative; width: 1rem; height: 1rem; margin-top: .45rem; }
  .cv__sign::before, .cv__sign::after { content: ''; position: absolute; left: 0; top: 50%; width: 100%; height: 1.5px; background: var(--accent); transition: transform var(--dur-2) var(--ease); }
  .cv__sign::after { transform: rotate(90deg); }
  .cv__item[open] .cv__sign::after { transform: rotate(0deg); }
  .cv__main { display: grid; gap: .35rem; }
  .cv__now { display: inline-flex; align-items: center; gap: .45rem; font: 500 .7rem/1 var(--f-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--accent); }
  .cv__now::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--accent); }
  .cv__title { font-family: var(--f-display); font-size: clamp(1.2rem, 1rem + .6vw, 1.55rem); font-weight: 500; line-height: 1.2; letter-spacing: -.02em; transition: color var(--dur-1) var(--ease); }
  .cv__item summary:hover .cv__title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .2em; }
  .cv__org { color: var(--ink-soft); font-size: 1.02rem; }
  .cv__side { display: grid; gap: .25rem; text-align: right; font-size: .78rem; padding-top: .35rem; white-space: nowrap; }

  .cv__more { padding: 0 0 var(--s-6) 2.4rem; display: grid; gap: var(--s-4); }
  .cv__detail, .cv__text { color: var(--ink-soft); max-width: 60ch; }
  .cv__text :global(p) { margin: 0; }
  .cv__text :global(code) { font-family: var(--f-mono); font-size: .84em; }
  .cv__block { display: grid; gap: .55rem; }
  .cv__chips { display: flex; flex-wrap: wrap; gap: .45rem; }
  .cv__chips li { font: 400 .76rem/1 var(--f-mono); padding: .5rem .7rem; border: var(--hair) solid var(--rule); border-radius: 999px; background: var(--surface); }

  .bg__lang { grid-column: 1 / span 6; margin-top: var(--s-8); padding-top: var(--s-5); border-top: var(--hair) solid var(--ink); display: grid; gap: .5rem; }
  .bg__lang p { font-family: var(--f-display); font-size: 1.25rem; }

  @media (max-width: 860px) {
    .bg__head, .bg__lang { grid-column: 1 / -1; }
    .cv { grid-template-columns: 1fr; gap: var(--s-8); }
    .cv__item summary { grid-template-columns: 1.2rem 1fr; }
    .cv__side { grid-column: 2; text-align: left; display: flex; gap: .8rem; padding-top: .2rem; }
    .cv__more { padding-left: 2.2rem; }
  }

  @media print {
    .bg__head h1 { font-size: 20pt; }
    .bg__intro, .bg__print { display: none; }
    .bg__printhead { font: 9pt var(--f-mono); margin: .3rem 0 1rem; }
    .cv { grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .cv__item summary { padding: .5rem 0; }
    .cv__sign { display: none; }
    .cv__more { display: grid !important; padding: 0 0 .6rem 0; }
    .cv__title { font-size: 11pt; }
  }
</style>
